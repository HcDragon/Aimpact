# Copy to supabase/functions/.env for local dev (`supabase functions serve` loads it).
# In production: supabase secrets set --env-file supabase/functions/.env

# Chat model for basic answers (assistant, command parsing, sentiment, insights)
CHAT_PROVIDER=groq            # groq | xai  (model names are in config/ai.json)
GROQ_API_KEY=
XAI_API_KEY=

# Gemini: bill photos, voice notes, photo/product search embeddings
GEMINI_API_KEY=

# Telegram bot token (only notify-telegram uses it; the bot itself is a separate service)
TELEGRAM_BOT_TOKEN=
