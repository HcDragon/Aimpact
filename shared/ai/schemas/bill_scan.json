{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smartinventory/bill_scan.json",
  "title": "Bill scan extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["supplier_name", "invoice_date", "gstin", "items", "invoice_total", "warnings"],
  "properties": {
    "supplier_name": {"type": ["string", "null"]},
    "invoice_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "gstin": {"type": ["string", "null"], "pattern": "^[0-9]{2}[A-Z0-9]{10}[0-9A-Z]Z[0-9A-Z]$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "qty", "unit", "unit_price", "gst_rate", "line_total"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "qty": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"type": ["string", "null"]},
          "unit_price": {"type": "number", "minimum": 0},
          "gst_rate": {"type": ["number", "null"], "enum": [0, 0.25, 3, 5, 12, 18, 28, 40, null]},
          "line_total": {"type": "number", "minimum": 0}
        }
      }
    },
    "invoice_total": {"type": ["number", "null"], "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
