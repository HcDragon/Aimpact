{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smartinventory/review.json",
  "title": "Review sentiment batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "sentiment", "aspects"],
        "properties": {
          "review_id": {"type": "string"},
          "sentiment": {"enum": ["positive", "negative", "neutral", "mixed"]},
          "aspects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["aspect", "polarity"],
              "properties": {
                "aspect": {"enum": ["taste", "price", "delivery", "hygiene", "quantity"]},
                "polarity": {"enum": ["positive", "negative", "neutral"]}
              }
            }
          }
        }
      }
    }
  }
}
